# Phase 1A.1.c — .env hygiene (R-17)
.env
.env.local
.env.*.local

# Chroma persistent store + uploaded datasets (R-16 backup convention)
data/chroma/
data/chroma_backup_*/
data/uploads/
# 无尾斜杠: data/study 为符号链接时同样被忽略
data/study

# Runtime logs (manual smoke + launchd stdout/stderr)
logs/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/
build/
dist/
# KG 查看器生成物 (scripts/build_kg_viewer.py 产出, 入库; lan-services Caddy 从这里拷)
!viewer/dist/

# Virtualenvs
.venv/
venv/
env/

# Type-checker / test cache
.mypy_cache/
.ruff_cache/
.pytest_cache/
.cache/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Streamlit
.streamlit/secrets.toml

# ⚑ dogfood 失败记录: 服务运行时 POST /api/flag 追加写, 属运行数据不进版本库 (本机保留, 规则 B 不删)
dogfood_failures.md
eval/runs/*.log

# OMC / Claude 运行时状态
**/.omc/

# P2 L2 限额计数库 (SQLite, 含 WAL/SHM)
data/quota.sqlite*
