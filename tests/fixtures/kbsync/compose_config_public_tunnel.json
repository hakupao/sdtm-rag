{
  "name": "sdtm-rag-public",
  "networks": {
    "public": {
      "name": "sdtm-rag-public",
      "driver": "bridge",
      "driver_opts": {
        "com.docker.network.bridge.name": "br-sdtmpub"
      },
      "ipam": {
        "config": [
          {
            "subnet": "10.201.8.0/24",
            "gateway": "10.201.8.1",
            "ip_range": "10.201.8.128/25"
          }
        ]
      },
      "enable_ipv6": false
    }
  },
  "services": {
    "api": {
      "restart": "unless-stopped",
      "container_name": "sdtm-rag-public-api",
      "command": null,
      "entrypoint": null,
      "environment": {
        "FORWARDED_ALLOW_IPS": "",
        "SDTM_RAG_INSTANCE": "public",
        "SDTM_RAG_QUOTA_TRUSTED_PROXIES": "10.201.8.2",
        "SDTM_RAG_RATE_LIMIT_BURST": "20",
        "SDTM_RAG_RATE_LIMIT_ENABLED": "true",
        "SDTM_RAG_RATE_LIMIT_PER_MIN": "60"
      },
      "image": "192.168.100.58/bojiang/sdtm-rag:abc",
      "mem_limit": "1610612736",
      "networks": {
        "public": null
      },
      "volumes": [
        {
          "type": "bind",
          "source": "/Volumes/DevSSD/deploy-data/sdtm-rag-public/data",
          "target": "/app/data",
          "bind": {
            "create_host_path": false
          }
        },
        {
          "type": "bind",
          "source": "/opt/sdtm-rag-public/.env",
          "target": "/app/.env",
          "read_only": true,
          "bind": {
            "create_host_path": false
          }
        }
      ],
      "healthcheck": {
        "test": [
          "CMD",
          "python",
          "-c",
          "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/api/health', timeout=4)"
        ],
        "timeout": "5s",
        "interval": "30s",
        "retries": 3,
        "start_period": "1m0s"
      }
    }
  }
}